# =========================================================================
# Agent Skills repository
#
# Tracked in git: SKILL.md, references/, assets/, scripts/ — the skill source.
# Ignored: local agent/IDE state, OS noise, caches, secrets and temp output.
# =========================================================================

# --- OS noise ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Local agent tooling state (machine-specific, never skill source) ----
# Claude Code / Qoder / Cursor / Windsurf / Aider local config and caches.
# Add an un-ignore rule (e.g. !.qoder/rules/) if a tool config should be shared.
.claude/
.agents/
.qoder/
.cursor/
.windsurf/
.aider*
# Lockfile written by the `skills` CLI when skills are installed in-place.
skills-lock.json
# Project-scoped MCP config — often holds local paths / secrets.
.mcp.json

# --- Environment + secrets -----------------------------------------------
.env
.env.*
!.env.example

# --- Logs / temp ---------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.bak

# --- Node tooling (only relevant if a skill ships scripts) ---------------
node_modules/
.cache/
dist/
build/

# --- Python tooling (only relevant if a skill ships scripts) -------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Safety net: skill source must never be ignored ----------------------
!**/SKILL.md
!**/references/**
!**/assets/**
!**/scripts/**
